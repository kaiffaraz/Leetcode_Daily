class Solution {
    public String[] sortPeople(String[] names, int[] heights) {
        for(int i = 0; i < heights.length - 1; i++){
            int max = i;
            for(int j = i + 1; j < heights.length; j++){
                if(heights[j] > heights[max]){
                    max = j;
                }
            }
            String temp = names[i];
            names[i] = names[max];
            names[max] = temp;

            int temp1 = heights[max];
            heights[max] = heights[i];
            heights[i] = temp1;
        }
        return names;
    }
}
