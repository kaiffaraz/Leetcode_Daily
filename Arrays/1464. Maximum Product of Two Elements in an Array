class Solution {
    public int maxProduct(int[] nums) {
        // Arrays.sort(nums);
        // ans1 = (nums[nums.length - 1] - 1) * (nums[nums.length - 2] - 1);
        int ans1 = 0;
        int ans2 = 0;
        for(int i = 0; i < nums.length; i++){
            if(nums[i] > ans1){
                ans2 = ans1;
                ans1 = nums[i];
            }
            else if(nums[i] > ans2){
                ans2 = nums[i];
            }
        }
        return (ans1 - 1) * (ans2 - 1);
    }
}
