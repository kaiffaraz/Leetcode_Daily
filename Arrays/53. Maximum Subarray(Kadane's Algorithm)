class Solution {
    public int maxSubArray(int[] nums) {
        int cSum = 0;
        int maxSum = nums[0];

        for(int i = 0; i < nums.length; i++){
            cSum = cSum + nums[i];

            if(cSum > maxSum){
                maxSum = cSum;
            }

            if(cSum < 0){
                cSum = 0;
            }
        }
        return maxSum;
    }
}
