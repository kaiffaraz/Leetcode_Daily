class Solution {
    public int maxArea(int[] height) {
        int ans = 0;
        int l = 0;
        int r = height.length - 1;
        while(l < r){
            int width = r - l ;
            int max = width * Math.min(height[l], height[r]);
            if(max > ans){
                ans = max;
            }
            if(height[l] > height[r]){
                r--;
            }
            else if(height[r] > height[l]){
                l++;
            }
            else{
                l++;
                r--;
            }
        }
        return ans;
    }
}
